---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import BlogPostClient from '../../components/BlogPostClient';
import BlogReader from '../../components/BlogReader';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const blogs = await getCollection('blogs');
  const sorted = blogs.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );
  return sorted.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      prev: sorted[i + 1]
        ? { slug: sorted[i + 1].data.slug, title: sorted[i + 1].data.title }
        : null,
      next: sorted[i - 1]
        ? { slug: sorted[i - 1].data.slug, title: sorted[i - 1].data.title }
        : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

function estimateReadTime(body: string): number {
  const words = (body ?? '').split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' });
}

const timeToRead = estimateReadTime(entry.body ?? '');
const formattedDate = formatDate(entry.data.date);
const url = `https://saiid.ch/blog/${entry.data.slug}/`;

const microdata = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  datePublished: entry.data.date.toISOString(),
  dateModified: entry.data.date.toISOString(),
  author: { "@type": "Person", name: "Saiid El Hajj Chehade" },
  publisher: {
    "@type": "Organization",
    name: "Saiid's Blog",
    logo: { "@type": "ImageObject", url: "https://saiid.ch/favicon-32x32.png" },
  },
  description: entry.data.summary,
  mainEntityOfPage: url,
  url: url,
  articleSection: entry.data.tags.join(", "),
  keywords: entry.data.tags.join(", "),
  isAccessibleForFree: true,
};

const cite = {
  title: entry.data.title,
  date: entry.data.date.toISOString(),
  slug: entry.data.slug,
};
---

<BaseLayout noMargin>
  <Fragment slot="head">
    <title>{entry.data.title} | Saiid's Blog</title>
    <meta name="description" content={entry.data.summary} />
    <meta name="keywords" content={entry.data.tags.join(", ")} />
    <meta property="og:title" content={entry.data.title} />
    <meta property="og:description" content={entry.data.summary} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={entry.data.date.toISOString()} />
    <meta property="article:author" content="Saiid El Hajj Chehade" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@saiid_hc" />
    <meta name="twitter:title" content={entry.data.title} />
    <meta name="twitter:description" content={entry.data.summary} />
    <meta name="twitter:site" content="@saiid_hc" />
    <script type="application/ld+json" set:html={JSON.stringify(microdata)} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  </Fragment>

  <div class="mb-10">
    <header class="relative w-screen header-gradient gap-10 flex flex-row justify-left pr-24 max-md:pr-8">
      <div class="grow">
        {entry.data.cover && (
          <img
            src={entry.data.cover}
            alt="Cover"
            class="h-full w-full object-cover max-md:opacity-30 max-md:absolute max-md:top-0 max-md:left-0 pointer-events-none"
            style="mask-image: linear-gradient(to right, rgba(0,0,0,0.7), rgba(0,0,0,0));"
          />
        )}
      </div>

      <div class="pt-24 pb-20 w-5/12 max-w-[600px] max-md:w-full max-md:p-8 max-md:pt-28 max-md:max-w-none z-20">
        <div class="flex flex-row items-center gap-x-4 flex-wrap">
          <a href="/blog/" class="text-secondary font-mono hover:underline">&larr; all blogs</a>
          <a
            href={`/blog/reader/${entry.data.slug}/`}
            class="font-mono text-xs px-3 py-1 border border-secondary/60 text-secondary rounded hover:bg-secondary hover:text-base-100 transition-colors"
            title="Distraction-free reader view"
          >
            Reader mode
          </a>
        </div>
        <h1
          class="font-mono text-5xl mt-8 mb-4 max-md:text-4xl"
          data-header-title={entry.data.title}
        >
          {entry.data.title}
        </h1>
        <div class="flex flex-row flex-wrap items-center gap-x-3 gap-y-1 text-sm font-mono text-muted mb-3">
          <span>{formattedDate}</span>
          <span>·</span>
          <span>{timeToRead} min read</span>
        </div>
        <div class="flex flex-row flex-wrap gap-2 mb-4">
          {entry.data.tags.map((tag) => (
            <a
              href={`/blog/?tag=${encodeURIComponent(tag)}`}
              class="badge badge-outline hover:border-secondary hover:text-secondary"
            >
              {tag}
            </a>
          ))}
        </div>
        <hr class="my-4 border-base-content/20" />
        <p class="text-lg">{entry.data.summary}</p>
      </div>
      <span
        class="absolute bottom-0 w-full h-2 header-gradient"
        style="filter: brightness(3);"
      ></span>
    </header>

    <article id="blog-content" class="mt-20 mb-20 blog max-w-[800px] mx-auto max-md:px-8">
      <Content />
    </article>

    <BlogReader contentSelector="#blog-content" client:load />

    <nav class="max-w-[800px] mx-auto mt-16 mb-12 grid grid-cols-2 gap-4 max-md:px-8">
      {prev ? (
        <a
          href={`/blog/${prev.slug}/`}
          class="group flex flex-col p-4 border border-base-content/10 rounded-lg hover:border-secondary/40 hover:bg-secondary/5 transition-colors"
        >
          <span class="text-xs font-mono text-muted uppercase tracking-wider">← Older</span>
          <span class="text-base font-mono font-semibold group-hover:text-secondary transition-colors mt-1">
            {prev.title}
          </span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a
          href={`/blog/${next.slug}/`}
          class="group flex flex-col p-4 border border-base-content/10 rounded-lg hover:border-secondary/40 hover:bg-secondary/5 transition-colors text-right"
        >
          <span class="text-xs font-mono text-muted uppercase tracking-wider">Newer →</span>
          <span class="text-base font-mono font-semibold group-hover:text-secondary transition-colors mt-1">
            {next.title}
          </span>
        </a>
      ) : (
        <span />
      )}
    </nav>

    <BlogPostClient
      slug={entry.data.slug}
      url={url}
      showFeedback
      cite={cite}
      client:load
    />
  </div>
</BaseLayout>
