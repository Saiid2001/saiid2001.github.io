---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Heading from '../../components/Heading.astro';
import BlogListClient from '../../components/BlogListClient';
import type { BlogSummary } from '../../components/BlogListClient';
import { getCollection } from 'astro:content';

const blogs = await getCollection('blogs');
const sortedBlogs = blogs.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function estimateReadTime(body: string): number {
  const words = (body ?? '').split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}

const posts: BlogSummary[] = sortedBlogs.map((blog) => ({
  slug: blog.data.slug,
  title: blog.data.title,
  date: blog.data.date.toISOString(),
  tags: blog.data.tags,
  summary: blog.data.summary,
  cover: blog.data.cover,
  readTime: estimateReadTime(blog.body ?? ''),
}));
---

<BaseLayout title="Blog | saiid.ch">
  <Fragment slot="head">
    <title>Saiid's Blog</title>
    <meta name="description" content="Notes on security, privacy, the web, and research from Saiid El Hajj Chehade." />
    <link rel="alternate" type="application/rss+xml" title="Saiid's Blog RSS Feed" href="/rss.xml" />
  </Fragment>
  <div class="flex flex-col items-left px-8 pl-32 max-lg:pl-8 justify-center w-full min-h-[70vh] mt-32 gap-y-8">
    <div class="flex flex-col gap-y-2">
      <Heading name="/blog" />
      <p class="text-lg text-muted max-w-[720px]">
        Notes on security, privacy, the web, and the messy realities of research.
      </p>
    </div>
    <BlogListClient posts={posts} client:load />
  </div>
</BaseLayout>
